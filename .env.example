# Copy to .env and load it however you run the server. Nothing here is required
# to run the calculator locally, but ADMIN_TOKEN is required to read leads back.

# Port the server listens on.
PORT=4173

# SQLite file that holds the leads.
LEAD_DB=leads.db

# Required to open /admin, GET /api/leads and download the CSV.
# Use a long random string in production.
ADMIN_TOKEN=

# Optional. Every saved lead is also POSTed here as JSON, fire and forget.
# Point it at a Zapier or Make catch hook, an n8n webhook or a CRM endpoint
# and leads reach the CRM today without any further code.
WEBHOOK_URL=
